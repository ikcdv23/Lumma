      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.6",
      "hono": "4.12.25",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.2",
      "mysql2": "3.22.0",
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "prosemirror-model": "1.25.4",
