// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folders   Folder[]
  notes     Note[]

  feedbackVotes FeedbackVote[]

  feedbackPosts FeedbackPost[]
  studySessions StudySession[]
}

model Account {
  id                String @id @default(uuid())
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  type              String
  provider          String
  providerAccountId String

  access_token  String? @db.Text
  refresh_token String? @db.Text

  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  sessionToken String   @unique
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Folder {
  id   String @id @default(uuid())
  name String @default("Carpeta sin título")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  userId        String
  notes         Note[]
  studySessions StudySession[]
}

model Note {
  id      String @id @default(uuid())
  title   String
  content Json   @default("{}")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
 
  studySessions StudySession[]

  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId String?

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model FeedbackPost {
  id        String         @id @default(uuid())
 
  content   String
  rating    Int
  votes     FeedbackVote[]
 
  createdAt DateTime       @default(now())
 
  author    User           @relation(fields: [authorId], references: [id])
  authorId  String
}

model FeedbackVote {
  user   User         @relation(fields: [userId], references: [id])
  userId String
 
  post   FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@id([userId, postId])
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model StudySession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folder Folder[]
  notes  Note[]

  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  lastSeenAt DateTime  @default(now())

  title         String
  targetMinutes Int
  studyMinutes  Int    @default(0)
  breakMinutes  Int    @default(0)

  status StudySessionStatus @default(ACTIVE)

  notesTouched String[]
  notesCreated String[]

  kanbanCards KanbanCard[]

  @@index([userId, startedAt])
  @@index([userId, status])
}

/// Tablero kanban ligado a UNA sesión de estudio. Empieza vacío al crear la
/// sesión y se desecha conceptualmente al cerrarla — los cards quedan
/// asociados a la sesión histórica para futura ficha técnica. 3 columnas
/// fijas (PENDING / IN_PROGRESS / DONE) para no caer en parálisis.
enum KanbanStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model KanbanCard {
  id             String       @id @default(uuid())
  studySessionId String
  studySession   StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)

  title  String
  status KanbanStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studySessionId, status])
  @@index([studySessionId, createdAt])
}
